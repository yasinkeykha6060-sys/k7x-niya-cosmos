  {"id":"proxima-b","slug":"proxima-b","nameFa":"پروکسیما قنطورس ب","nameEn":"Proxima Centauri b","systemId":"proxima","discoveryYear":2016,"methodFa":"سرعت شعاعی","summaryFa":"سیاره‌ای در مدار نزدیک به پروکسیما. جرم حداقل از سرعت شعاعی به دست می‌آید و شعاع گذر تأییدشده‌ای در این صفحه نقل نشده.","sources":[{"name":"NASA Exoplanet Archive","url":"https://exoplanetarchive.ipac.caltech.edu/","retrieved":"2026-11-15"}]},
  {"id":"kepler-452-b","slug":"kepler-452-b","nameFa":"کپلر-۴۵۲ ب","nameEn":"Kepler-452 b","systemId":"kepler-452","discoveryYear":2015,"methodFa":"گذر","summaryFa":"سیاره‌ای بزرگ‌تر از زمین به گرد ستاره‌ای شبیه خورشید، با سال بلندتر از سال زمین. شعاع دقیق را نقل نکرده‌ام.","sources":[{"name":"NASA Kepler","url":"https://science.nasa.gov/mission/kepler/","retrieved":"2026-11-15"}]},
  {"id":"kepler-186-f","slug":"kepler-186-f","nameFa":"کپلر-۱۸۶ اف","nameEn":"Kepler-186 f","systemId":"kepler-186","discoveryYear":2014,"methodFa":"گذر","summaryFa":"بیرونی‌ترین سیاره‌ی شناخته‌شده‌ی کپلر-۱۸۶. اندازه‌اش نزدیک زمین توصیف شده، بدون اینکه اینجا یک شعاع اعشاری بیاورم.","sources":[{"name":"NASA Kepler","url":"https://science.nasa.gov/mission/kepler/","retrieved":"2026-11-15"}]},
  {"id":"hd-209458-b","slug":"hd-209458-b","nameFa":"اچ‌دی ۲۰۹۴۵۸ ب","nameEn":"HD 209458 b","systemId":"hd-209458","discoveryYear":1999,"methodFa":"گذر","summaryFa":"مشتری داغی که گذرش در ۱۹۹۹ دیده شد و بعداً جوّش با طیف عبوری بررسی شد. نام غیررسمی اسیریس هم برایش به کار رفته است.","sources":[{"name":"NASA Exoplanet Archive","url":"https://exoplanetarchive.ipac.caltech.edu/","retrieved":"2026-11-15"}]},
  {"id":"51-peg-b","slug":"51-peg-b","nameFa":"۵۱ فرس اعظم ب","nameEn":"51 Pegasi b","systemId":"51-peg","discoveryYear":1995,"methodFa":"سرعت شعاعی","summaryFa":"نخستین مشتری داغ شناخته‌شده به گرد ستاره‌ای شبیه خورشید. کشف ۱۹۹۵، جایزه‌ی نوبل ۲۰۱۹ برای روش.","sources":[{"name":"Nobel Prize in Physics 2019","url":"https://www.nobelprize.org/prizes/physics/2019/summary/","retrieved":"2026-11-15"}]},
  {"id":"55-cnc-e","slug":"55-cnc-e","nameFa":"۵۵ سرطان ای","nameEn":"55 Cancri e","systemId":"55-cnc","discoveryYear":2004,"methodFa":"سرعت شعاعی","summaryFa":"ابرزمین داغ در مداری بسیار کوتاه. سطح یا جوّش هنوز محل بحث است و اینجا یک ترکیب قطعی نقل نمی‌شود.","sources":[{"name":"NASA Exoplanet Archive","url":"https://exoplanetarchive.ipac.caltech.edu/","retrieved":"2026-11-15"}]},
  {"id":"toi-700-d","slug":"toi-700-d","nameFa":"تی‌او‌آی-۷۰۰ د","nameEn":"TOI-700 d","systemId":"toi-700","discoveryYear":2020,"methodFa":"گذر","summaryFa":"سیاره‌ای تقریباً در اندازه‌ی زمین که تِس در ناحیه‌ی قابل‌سکونت ستاره‌ی میزبان پیدا کرد. ناحیه‌ی قابل‌سکونت یک تعریف تابشی است.","sources":[{"name":"NASA TESS","url":"https://science.nasa.gov/missions/tess/","retrieved":"2026-11-15"}]},
  {"id":"yn-001-b","slug":"yn-001-b","nameFa":"یاسین","nameEn":"YN-001 b","systemId":"yn-001","summaryFa":"سیاره‌ی خیالی این آلبوم. مشخصات عددی‌اش فرضی است و از رصد نیامده. دوره‌ی گردش در صفحه از قانون سوم کپلر و جرم ستاره‌ی فرضی حساب می‌شود.","sources":[{"name":"data/personal.json","url":"https://www.iau.org/public/themes/naming_exoplanets/","retrieved":"2026-11-15"}]}
